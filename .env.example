# stdio only. The hosted HTTP server ignores it: every caller sends their own key.
CXCALLER_API_KEY=cxk_...

# Default: https://api.cxcaller.com  (dev: https://dev.api.cxcaller.com)
CXCALLER_API_URL=https://api.cxcaller.com

# Hide every tool that places calls or changes data.
# CXCALLER_MCP_READ_ONLY=true

# Comma list of: account,contacts,campaigns,calls,analytics  (default: all)
# CXCALLER_MCP_TOOLSETS=calls,campaigns

# Largest campaign an agent may launch, checked against the real recipient count at launch.
# CXCALLER_MCP_MAX_RECIPIENTS=1000

# Per-request timeout to the CXCaller API.
# CXCALLER_MCP_TIMEOUT_MS=30000

# --- Hosted (--http) ---------------------------------------------------------
# CXCALLER_MCP_ALLOWED_HOSTS=mcp.cxcaller.com
# CXCALLER_MCP_TRUST_PROXY=true          # only when reachable solely via Cloudflare/a trusted proxy
# CXCALLER_MCP_RATE_LIMIT_PER_MINUTE=300  # per organization, per pod
# CXCALLER_MCP_MAX_CONCURRENT=8
# CXCALLER_MCP_FAILED_AUTH_PER_MINUTE=30
# CXCALLER_MCP_MAX_WAIT_SECONDS=80        # keep below Cloudflare's 100 s edge limit
# CXCALLER_MCP_SHUTDOWN_GRACE_MS=100000
